<?xml version="1.0" encoding="UTF-8"?>

<!-- gz-sim (Ignition Fortress) port of main_limo_basic.launch.xml. Uses the
     same ROS topics as the Classic pipeline (see
     ros_gz_bridge_limo_acker_basic.yaml for the mapping and its one known
     gap: "/demo/distance_demo" has no gz-sim source to bridge from). -->
<launch>
    <!-- External Argument Declarations (if needed) -->
    <arg name="use_sim_time" default="true" description="Whether to use simulation time"/>
    <arg name="world" default="$(find-pkg-share limo_description)/worlds/hard_track.world" description="Which world file to load"/>
    <arg name="urdf_model" default="$(find-pkg-share limo_description)/urdf/limo_four_acker_ignition.xacro" description="Which robot model we use"/>
    <arg name="x_spawn" default="-2.0" description="X position to spawn the robot at"/>
    <arg name="y_spawn" default="-1.075" description="Y position to spawn the robot at"/>
    <arg name="z_spawn" default="0.0" description="Z position to spawn the robot at"/>
    <arg name="yaw_spawn" default="-3.140" description="Yaw orientation to spawn the robot at"/>

    <!-- Including another launch file with arguments -->
    <include file="$(find-pkg-share limo_description)/launch/gazebo_models_diff_mod_empty_acker_ignition.launch.py">
        <!-- Pass arguments to the included launch file -->
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="world" value="$(var world)"/>
        <arg name="urdf_model" value="$(var urdf_model)"/>
        <arg name="x_spawn" value="$(var x_spawn)"/>
        <arg name="y_spawn" value="$(var y_spawn)"/>
        <arg name="z_spawn" value="$(var z_spawn)"/>
        <arg name="yaw_spawn" value="$(var yaw_spawn)"/>
    </include>
</launch>
