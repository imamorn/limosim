<?xml version="1.0" encoding="UTF-8"?>

<!-- Same as main_limo_stage_ignition.launch.xml, but loads
     stage_traffic_light.world (which has a traffic_light: 12 overlay lamps,
     red/yellow/green on each of its 4 faces, on the pole already baked into
     limo_stage1's mesh) and starts traffic_light_controller, which runs a
     real intersection cycle: n/s (one road) and e/w (the crossing road) each
     show one synchronized color, swapping through green -> yellow -> red so
     the two axes are never both green at once (see traffic_light_controller.
     cpp for the /traffic_light/state topic that overrides all 4 faces to a
     single fixed color manually instead). -->
<launch>
    <!-- External Argument Declarations (if needed) -->
    <arg name="use_sim_time" default="true" description="Whether to use simulation time"/>
    <arg name="world" default="$(find-pkg-share limo_description)/worlds/stage_traffic_light.world" description="Which world file to load"/>
    <arg name="urdf_model" default="$(find-pkg-share limo_description)/urdf/limo_four_acker_ignition.xacro" description="Which robot model we use"/>
    <arg name="green_duration" default="6.0" description="Seconds each axis holds green"/>
    <arg name="yellow_duration" default="2.0" description="Seconds each axis holds yellow before the other axis goes green"/>

    <!-- Including another launch file with arguments -->
    <include file="$(find-pkg-share limo_description)/launch/gazebo_models_diff_mod_empty_acker_ignition.launch.py">
        <!-- Pass arguments to the included launch file -->
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="world" value="$(var world)"/>
        <arg name="urdf_model" value="$(var urdf_model)"/>
    </include>

    <node pkg="limo_description" exec="traffic_light_controller" name="traffic_light_controller">
        <param name="green_duration" value="$(var green_duration)"/>
        <param name="yellow_duration" value="$(var yellow_duration)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
</launch>
