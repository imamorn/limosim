<?xml version="1.0" encoding="UTF-8"?>

<!-- gz-sim (Ignition Fortress) port of spawn.launch.xml: same per-robot
     composition, swapping the Classic spawn_in_gazebo.launch.py for its
     gz-sim counterpart. robot_state_publisher.launch.py is unchanged;
     it just xacro-processes whatever robot_file is given. -->
<launch>

    <arg name="robot_name" default="limo1"/>
    <arg name="robot_file" default="limo_four_diff_ignition.xacro"/>
    <arg name="x_spawn" default="0.0"/>
    <arg name="y_spawn" default="0.0"/>
    <arg name="z_spawn" default="0.0"/>
    <arg name="roll_spawn" default="0.0"/>
    <arg name="pitch_spawn" default="0.0"/>
    <arg name="yaw_spawn" default="0.0"/>

    <include file="$(find-pkg-share limo_description)/launch/robot_state_publisher.launch.py">
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="robot_file" value="$(var robot_file)"/>
    </include>


    <include file="$(find-pkg-share limo_description)/launch/spawn_in_gazebo_ignition.launch.py">
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="x_spawn" value="$(var x_spawn)"/>
        <arg name="y_spawn" value="$(var y_spawn)"/>
        <arg name="z_spawn" value="$(var z_spawn)"/>
        <arg name="roll_spawn" value="$(var roll_spawn)"/>
        <arg name="pitch_spawn" value="$(var pitch_spawn)"/>
        <arg name="yaw_spawn" value="$(var yaw_spawn)"/>
    </include>

</launch>
