<?xml version='1.0'?>
<sdf version='1.4'>
    <model name='conde_world'>
      <static>1</static>
      <link name='link_ground'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1.74 4.17</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
            <bounce/>
            <contact>
              <ode/>
            </contact>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual_ground'>
          <cast_shadows>0</cast_shadows>
	  <pose>0 0 .005 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1.74 4.17</size>
            </plane>
          </geometry>
          <material>
            <!-- ogre2 (gz-sim) does not support the legacy Ogre1 .material
                 script format used by materials/scripts/floor.material, so
                 the texture is referenced directly via PBR maps. metalness
                 must be 0 (the default from just an albedo_map is a mirror-
                 like metal that reflects the sky and washes the track out
                 near-white); emissive_map reproduces the original script's
                 "emissive 0.9" so the black/white track stays crisp and
                 unaffected by scene lighting, matching floor.png as-is. -->
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
            <emissive>0.9 0.9 0.9 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://conde_world/materials/textures/floor.png</albedo_map>
                <emissive_map>model://conde_world/materials/textures/floor.png</emissive_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <velocity_decay>
          <linear>0</linear>
          <angular>0</angular>
        </velocity_decay>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <gravity>1</gravity>
      </link>
      <pose>0 0 0 0 -0 0</pose>
    </model>
</sdf>
