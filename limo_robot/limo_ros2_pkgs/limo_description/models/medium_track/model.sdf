<?xml version="1.0"?>
<sdf version="1.6">
<model name="medium_track">
  <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>6 6</size>
          </plane>
        </geometry>
        <material>
          <!-- ogre2 (gz-sim) does not support the legacy Ogre1 .material
               script format used by meshes/scripts/medium_track.material,
               so the texture is referenced directly via a PBR albedo map.
               metalness must be 0 (its default from just an albedo_map is
               a mirror-like metal that reflects the sky and washes the
               texture out near-white). -->
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://medium_track/meshes/textures/medium_track.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
