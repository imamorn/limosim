<?xml version="1.0"?>
<model>
  <name>traffic_light</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>

  <author>
    <name>limosim</name>
  </author>

  <description>
    Twelve overlay lamps (lamp_&lt;red|yellow|green&gt;_&lt;n|s|e|w&gt;, on link
    "lamp_link"), positioned to sit exactly on the lens openings of all 4
    faces of the traffic-light pole already baked into limo_stage1's mesh --
    no pole or housing of its own. Each lamp starts dim/unlit and is switched
    to a bright, emissive color at runtime through gz-sim's
    /world/&lt;world&gt;/visual_config service. traffic_light_controller.cpp
    drives n/s and e/w as two synchronized axes so they're never both green.
  </description>
</model>
